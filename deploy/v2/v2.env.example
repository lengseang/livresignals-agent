# Copy to /opt/trading-agent-v2/config/v2.env  (git-ignored by *.env)  and  chmod 600 /opt/trading-agent-v2/config/v2.env
# The Jev (TypeSafe) key. Use a NEW key: the one used during development must be rotated.
TYPESAFE_API_KEY=
# Where the V2 paper chains, heartbeat, scorecard and watchdog state live (append-only; never hand-edit).
V2_OUT=/opt/trading-agent-v2/data/v2/paper
# lane B (volatility-scaled bracket, owner decision E16): its own book and chains
V2_OUT_B=/opt/trading-agent-v2/data/v2/paper-b
V2_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
V2_CADENCE=15
# Telegram alerts go through the box's hermes CLI (as the VPS heartbeat does). Set the path if pm2 lacks it on PATH.
HERMES_BIN=/home/ubuntu/hermes-venv/bin/hermes
HERMES_HOME=/home/ubuntu/hermes-home
